{
  "name": "sysupdate-client",
  "version": "1.2.0",
  "description": "SysUpdate client tray application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "pack": "electron-builder --win --dir"
  },
  "author": "SysUpdate",
  "license": "ISC",
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.sysupdate.client",
    "productName": "SysUpdate",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "allowElevation": true,
      "runAfterFinish": true,
      "installerSidebar": null
    },
    "files": [
      "main.js",
      "agent.js",
      "terminal.js",
      "assets/**"
    ]
  }
}
