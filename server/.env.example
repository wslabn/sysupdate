# Server
PORT=3000
JWT_SECRET=change-this-to-a-random-string-64-chars
ADMIN_PASSWORD=change-this-to-a-strong-password

# Agent authentication (clients must send this to connect)
AGENT_SECRET=change-this-to-a-shared-secret

# PostgreSQL
DATABASE_URL=postgresql://sysupdate:password@localhost:5432/sysupdate

# For Azure production:
# DATABASE_URL=postgresql://user:pass@your-server.postgres.database.azure.com:5432/sysupdate?sslmode=require
